# Copy to .env and change every secret before deploying.

# --- App ---
APP_PORT=3000
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
# Whoever registers with this username becomes admin and can manage tables.
ADMIN_USERNAME=admin
STARTING_BALANCE=1000
# Set to true when the site is served over HTTPS (e.g. behind a reverse proxy).
COOKIE_SECURE=false

# --- Game timing and house rules ---
FIRST_BET_SECONDS=10
BETTING_SECONDS=45
INSURANCE_SECONDS=10
TURN_SECONDS=20
DEALER_HITS_SOFT_17=false
DECKS=6

# --- MySQL (use URL-safe passwords: letters, digits, - and _) ---
MYSQL_DATABASE=blackjack
MYSQL_USER=blackjack
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- Adminer (web DB manager) ---
ADMINER_PORT=8080
ADMINER_BIND=127.0.0.1
