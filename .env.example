# Copy to .env and change every secret before deploying.

# --- App ---
APP_PORT=3000
# Long random string (at least 32 characters), e.g. `openssl rand -hex 32`. The server refuses to start
# with this placeholder.
JWT_SECRET=change-me-to-a-long-random-string
# Whoever registers with this username becomes admin and can manage tables. Pick a name that is hard to
# guess and register it right after the first start, before sharing the site.
ADMIN_USERNAME=admin
STARTING_BALANCE=1000
# Hours a player waits between two free refills.
REFILL_COOLDOWN_HOURS=24
# Set to true when the site is served over HTTPS (e.g. behind a reverse proxy).
COOKIE_SECURE=false
# Set to true behind a reverse proxy, so rate limits see real client IPs (X-Forwarded-For).
# Leave false when the app port is reachable directly: clients could fake the header.
TRUST_PROXY=false
# Extra origins allowed to call the API, comma separated. Only needed when the proxy rewrites the Host header,
# e.g. ALLOWED_ORIGINS=https://cards.example.com
ALLOWED_ORIGINS=

# --- Game timing and house rules ---
FIRST_BET_SECONDS=10
BETTING_SECONDS=45
INSURANCE_SECONDS=10
TURN_SECONDS=20
DEALER_HITS_SOFT_17=false
DECKS=6

# --- MySQL (use URL-safe passwords: letters, digits, - and _) ---
MYSQL_DATABASE=blackjack
MYSQL_USER=blackjack
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- Adminer (web DB manager) ---
ADMINER_PORT=8080
ADMINER_BIND=127.0.0.1
